{
 "$comment": "Example business model for the 'energy supervision' deployment (spec supervision-energetique-spec-fonctionnelle.md §4.1). Applied at boot by the fap-ldp node: creates the app.* tables, triggers, RLS policies, records dsp.asset_mapping and creates the initial ACLs. The corresponding SQL (validated on Postgres 16) is in 004_app.sql / 005_rls.sql in this folder.",
 "base_iri": "https://<pod>/",
 "tables": {
  "users": {
   "pk": "id",
   "owner": null,
   "published": false,
   "fields": {
    "id": "bigserial",
    "webid": "text unique not null",
    "name": "text not null",
    "email": "text unique",
    "role": "text check in ('manager','technician','admin')",
    "created_at": "timestamptz default now()",
    "updated_at": "timestamptz default now()"
   }
  },
  "buildings": {
   "pk": "id",
   "owner": null,
   "published": true,
   "fields": {
    "id": "bigserial",
    "name": "text not null",
    "address": "text",
    "meter_id": "text",
    "facis_asset": "text (DSP catalog asset IRI)",
    "created_at": "timestamptz default now()",
    "updated_at": "timestamptz default now()",
    "lat": "double precision (WGS84, nullable)",
    "lon": "double precision (WGS84, nullable)"
   }
  },
  "tickets": {
   "pk": "id",
   "owner": "created_by",
   "published": false,
   "tombstone": "deleted_at",
   "fields": {
    "id": "bigserial",
    "title": "text not null",
    "description": "text",
    "status": "text default 'OPEN' check in ('OPEN','IN_PROGRESS','RESOLVED','CLOSED')",
    "priority": "text",
    "building_id": "bigint fk buildings(id)",
    "anomaly_ref": "text (gold row IRI)",
    "created_by": "bigint fk users(id)",
    "assigned_to": "bigint fk users(id)",
    "created_at": "timestamptz default now()",
    "updated_at": "timestamptz default now()",
    "deleted_at": "timestamptz"
   }
  },
  "comments": {
   "pk": "id",
   "owner": "author",
   "published": false,
   "parent": "tickets",
   "parent_fk": "ticket_id",
   "fields": {
    "id": "bigserial",
    "ticket_id": "bigint fk tickets(id)",
    "author": "bigint fk users(id)",
    "text": "text not null",
    "ts": "timestamptz default now()"
   }
  }
 },
 "business_rules": [
  {
   "table": "tickets",
   "field": "status",
   "on_create": {
    "OPEN": [
     "manager"
    ]
   },
   "transitions": {
    "OPEN": {
     "IN_PROGRESS": [
      "manager",
      "assigned_to"
     ]
    },
    "IN_PROGRESS": {
     "RESOLVED": [
      "manager",
      "assigned_to"
     ]
    },
    "RESOLVED": {
     "CLOSED": [
      "manager"
     ],
     "IN_PROGRESS": [
      "manager"
     ]
    },
    "CLOSED": {
     "OPEN": [
      "manager"
     ]
    }
   }
  }
 ]
}