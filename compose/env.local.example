# LOCAL example — copy to compose/.env to deploy on this machine:
#   cp compose/env.local.example compose/.env && make -C compose deploy
# (compose/.env is gitignored; CHANGE_ME secrets are auto-generated on first run)
DOMAIN=app.localhost
# automatically resolves to 127.0.0.1 (*.localhost); otherwise add to /etc/hosts:
#   127.0.0.1 app.localhost

# Per-role PG secrets (auto-generated if CHANGE_ME)
PG_GATE_PASSWORD=CHANGE_ME
PG_APP_PASSWORD=CHANGE_ME
PG_READER_PASSWORD=CHANGE_ME
PG_MATERIALIZER_PASSWORD=CHANGE_ME

# Embedded Keycloak (DPoP enabled in the shipped realm)
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# To use the step-1 external IdP instead of the embedded Keycloak:
# IDP_EXTERNAL=true
# IDP_ISSUER_URL=https://idp.example/realms/fap
# IDP_CLIENT_ID=fap-ldp
