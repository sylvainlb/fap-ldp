# Exemple LOCAL — copier en compose/.env pour déployer sur cette machine :
#   cp compose/env.local.example compose/.env && make -C compose deploy
# (compose/.env est gitignoré ; les secrets CHANGE_ME sont auto-générés au premier run)
DOMAIN=app.localhost
# résolu automatiquement en 127.0.0.1 (*.localhost) ; sinon ajouter à /etc/hosts :
#   127.0.0.1 app.localhost

# Secrets PG par rôle (auto-générés si CHANGE_ME)
PG_GATE_PASSWORD=CHANGE_ME
PG_APP_PASSWORD=CHANGE_ME
PG_READER_PASSWORD=CHANGE_ME
PG_MATERIALIZER_PASSWORD=CHANGE_ME

# Keycloak embarqué (DPoP activé dans le realm livré)
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Pour utiliser l'IdP externe de l'étape 1 au lieu du Keycloak embarqué :
# IDP_EXTERNAL=true
# IDP_ISSUER_URL=https://idp.example/realms/fap
# IDP_CLIENT_ID=fap-ldp
