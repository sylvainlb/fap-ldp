# Caddyfile — TLS front (443). Local: DOMAIN=app.localhost; prod: A record to the VM.
{
  auto_https off
}

:80 {
  redir https://{host}{uri} permanent
}

https://{$DOMAIN:localhost} {
  # IdP (Keycloak) — /auth/*
  handle /auth/* {
    uri strip_prefix /auth
    reverse_proxy keycloak:8080
  }
  # DSP data plane of the FAP core
  handle /dsp/* {
    reverse_proxy orce:1880
  }
  # Node-RED editor (admin)
  handle /editor* {
    reverse_proxy orce:1880
  }
  # App front (same-origin /app/) + root LDP endpoint
  handle {
    reverse_proxy orce:1880
  }
}
